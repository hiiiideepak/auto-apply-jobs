# Copy to .env and fill in to send email applications.
# Without SMTP, email jobs are saved as drafts in the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=deepakbharti823@gmail.com

# Read application verification codes from Gmail.
# A normal Gmail password will not work. Turn on 2-Step Verification, then create
# an app password at https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_USER=deepakbharti823@gmail.com
IMAP_PASSWORD=

# Agent model. Uses ANTHROPIC_API_KEY from the environment.
# LLM_MODEL=claude-sonnet-5

# Set to 0 to discover jobs without submitting.
APPLY_ENABLED=1
PORT=8788
